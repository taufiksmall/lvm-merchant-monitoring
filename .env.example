# Salin menjadi .env.local untuk pengembangan lokal. Di Vercel, isi lewat
# Project Settings > Environment Variables. JANGAN commit nilai asli.

# URL Web App Apps Script (diakhiri /exec). Hanya dipakai di server Next.js.
# Lokal dengan emulator: http://localhost:8787/exec
APPS_SCRIPT_URL=http://localhost:8787/exec

# Rahasia bersama server Next.js <-> Apps Script (sama dengan Script Property API_SHARED_SECRET).
# Buat dengan: openssl rand -hex 32
APPS_SCRIPT_API_KEY=ganti-dengan-string-acak-minimal-32-karakter

# Konfigurasi publik (aman terlihat di browser).
NEXT_PUBLIC_APP_NAME=Monitoring Merchant LVM
