{
  "name": "lvm-merchant-monitoring",
  "version": "1.0.0",
  "private": true,
  "description": "Monitoring merchant LVM per cabang menuju rasio USAK 50% (Next.js + Google Apps Script + Google Sheets).",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
